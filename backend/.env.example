# ==========================================
# GEOCAST Backend Environment Variables
# ==========================================

# Secret key for Admin JWT Authentication
SECRET_KEY=geocast_jwt_secret_hackathon_2026_supersecure

# Database Connection
# For PostgreSQL + PostGIS:
DATABASE_URL=postgresql://geocast_user:geocast_password@localhost:5432/geocast_db
# For SQLite (Local rapid testing):
# DATABASE_URL=sqlite:///./geocast.db

# Media Storage ("local", "supabase", or "s3")
STORAGE_TYPE=local

# Device Monitoring
DEVICE_OFFLINE_THRESHOLD_SECONDS=40

# (Optional) AWS S3 / Supabase Storage S3-compatible Credentials
# S3_BUCKET=geocast-media
# S3_ENDPOINT=https://your-project.supabase.co/storage/v1/s3
# S3_ACCESS_KEY=your_access_key
# S3_SECRET_KEY=your_secret_key
